# CertiChain backend environment — copy to .env and fill in. NEVER commit the real .env.
# Generate a JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

NODE_ENV=development
PORT=5000

# Local MongoDB (service must be running)
MONGO_URI=mongodb://127.0.0.1:27017/certichain

# Auth
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_BYTES
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Blockchain (read-only access — the backend never holds private keys)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# CORS + QR link base
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Uploads
MAX_UPLOAD_BYTES=10485760

# Rate limits (requests per window) — configurable so tests can exercise the 429 path
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_VERIFY=60
RATE_LIMIT_UPLOAD=30

# Seed admin account (npm run seed)
ADMIN_EMAIL=admin@certichain.local
ADMIN_PASSWORD=CertiChain-Admin-2026!
